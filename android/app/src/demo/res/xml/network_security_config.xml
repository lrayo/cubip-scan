<?xml version="1.0" encoding="utf-8"?>
<!--
  Flavor demo: cleartext (http) permitido a nivel de app para el piloto en la
  LAN (p. ej. http://192.168.x.x:puerto). Android no admite rangos de IP en
  network_security_config, así que la restricción a la LAN (10/8, 172.16/12,
  192.168/16, 127/8, localhost y *.local) la aplica la app en el validador
  de URLs, no este archivo.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
