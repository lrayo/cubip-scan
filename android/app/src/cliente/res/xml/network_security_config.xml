<?xml version="1.0" encoding="utf-8"?>
<!--
  Flavor cliente: cleartext (http) prohibido, incluso en la LAN.
  La app también rechaza cualquier URL http en el validador.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
